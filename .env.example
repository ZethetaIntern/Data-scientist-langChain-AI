# ── LLM provider ─────────────────────────────────────────────────────────────
# One of: auto | openai | anthropic | groq | ollama | heuristic
#   auto      → picks the first provider that has an API key (openai → anthropic → groq),
#               otherwise falls back to the deterministic "heuristic" mode (no LLM needed).
#   heuristic → never calls an LLM. Every answer is computed with pandas / scikit-learn.
DS_LLM_PROVIDER=auto

# Optional model override. Defaults per provider:
#   openai=gpt-4o-mini  anthropic=claude-3-5-haiku-latest  groq=llama-3.3-70b-versatile  ollama=llama3.1
# DS_LLM_MODEL=gpt-4o-mini

# Sampling temperature for the agent (keep it low for analysis work)
DS_LLM_TEMPERATURE=0

# ── Provider credentials (only the one you use is required) ──────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OLLAMA_BASE_URL=http://localhost:11434

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Maximum tool calls the agent may make for a single question
DS_MAX_ITERATIONS=8

# Allow the LLM to run *restricted* pandas expressions on the dataframe
# (AST-allow-listed, no imports / attribute dunders / file access). Off by default.
DS_ENABLE_CODE_TOOL=false

# ── Data limits ──────────────────────────────────────────────────────────────
DS_MAX_UPLOAD_MB=25
DS_MAX_ROWS=200000
DS_MAX_COLUMNS=100
DS_MAX_DATASETS=6

# Where rendered charts are written (served under /api/artifacts)
DS_ARTIFACT_DIR=artifacts

# Comma-separated origins allowed by CORS (only needed when the frontend is on a different origin)
DS_CORS_ORIGINS=http://localhost:5173
